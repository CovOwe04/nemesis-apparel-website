{
  "name": "Jersey",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Jersey Name"
    },
    "team": {
      "type": "string",
      "title": "Team"
    },
    "category": {
      "type": "string",
      "enum": [
        "Jersey",
        "Long Sleeve",
        "Hoodie",
        "Bag",
        "Hat"
      ],
      "default": "Jersey",
      "title": "Product Category"
    },
    "fitting": {
      "type": "string",
      "enum": [
        "Slim",
        "Regular",
        "Loose"
      ],
      "default": "Regular"
    },
    "net_terms": {
      "type": "string",
      "enum": [
        "",
        "net_15",
        "net_30",
        "net_60",
        "net_90"
      ],
      "default": "",
      "title": "Net Payment Terms"
    },
    "price": {
      "type": "number",
      "title": "Price (USD)"
    },
    "colors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "hex": {
            "type": "string",
            "default": "#000000"
          },
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                }
              }
            }
          },
          "artwork_front": {
            "type": "string",
            "default": ""
          },
          "artwork_back": {
            "type": "string",
            "default": ""
          },
          "artwork_sleeve": {
            "type": "string",
            "default": ""
          },
          "artwork_hood": {
            "type": "string",
            "default": ""
          }
        }
      },
      "default": [],
      "title": "Color Variants"
    },
    "name_number_combos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "number": {
            "type": "string"
          }
        }
      },
      "default": [],
      "title": "Name & Number Presets"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "number": {
            "type": "string"
          }
        }
      },
      "default": [],
      "title": "Product Images (Legacy)"
    },
    "front_image": {
      "type": "string",
      "title": "Front Image URL"
    },
    "back_image": {
      "type": "string",
      "title": "Back Image URL"
    },
    "enable_customization": {
      "type": "boolean",
      "default": true,
      "title": "Enable Identity Lab"
    },
    "enable_name": {
      "type": "boolean",
      "default": true,
      "title": "Enable Name Customization"
    },
    "enable_number": {
      "type": "boolean",
      "default": true,
      "title": "Enable Number Customization"
    },
    "static_display": {
      "type": "boolean",
      "default": false,
      "title": "Static Display (No Flip)"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "title": "Featured on Landing"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "title": "Listing Sort Order"
    },
    "name_style": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string",
          "default": "#F5F5F7"
        },
        "outline": {
          "type": "boolean",
          "default": true
        },
        "outline_color": {
          "type": "string",
          "default": "#0A0A0A"
        },
        "outline_thickness": {
          "type": "number",
          "default": 1.4
        },
        "arch": {
          "type": "number",
          "default": 0
        },
        "rise": {
          "type": "number",
          "default": 0
        },
        "flag": {
          "type": "number",
          "default": 0
        },
        "horiz_pos": {
          "type": "number",
          "default": 12
        },
        "vert_pos": {
          "type": "number",
          "default": 99
        },
        "font_size": {
          "type": "number",
          "default": 8
        }
      },
      "default": {}
    },
    "number_style": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string",
          "default": "#F5F5F7"
        },
        "outline": {
          "type": "boolean",
          "default": true
        },
        "outline_color": {
          "type": "string",
          "default": "#0A0A0A"
        },
        "outline_thickness": {
          "type": "number",
          "default": 1.4
        },
        "arch": {
          "type": "number",
          "default": 0
        },
        "rise": {
          "type": "number",
          "default": 0
        },
        "flag": {
          "type": "number",
          "default": 0
        },
        "horiz_pos": {
          "type": "number",
          "default": 12
        },
        "vert_pos": {
          "type": "number",
          "default": 23
        },
        "font_size": {
          "type": "number",
          "default": 35
        }
      },
      "default": {}
    },
    "custom_font_url": {
      "type": "string",
      "default": "",
      "title": "Custom Font File URL"
    },
    "custom_font_name": {
      "type": "string",
      "default": "",
      "title": "Custom Font Name"
    },
    "is_private": {
      "type": "boolean",
      "default": false,
      "title": "Private (Club Exclusive)"
    },
    "private_access_code": {
      "type": "string",
      "default": "",
      "title": "Private Access Code"
    },
    "available_from": {
      "type": "string",
      "format": "date-time",
      "default": "",
      "title": "Available From"
    },
    "available_until": {
      "type": "string",
      "format": "date-time",
      "default": "",
      "title": "Available Until"
    },
    "merchize_product_id": {
      "type": "string",
      "default": "",
      "title": "Merchize Product ID"
    },
    "merchize_product_title": {
      "type": "string",
      "default": "",
      "title": "Merchize Product Title"
    },
    "merchize_variants": {
      "type": "object",
      "properties": {
        "XS": {
          "type": "string"
        },
        "S": {
          "type": "string"
        },
        "M": {
          "type": "string"
        },
        "L": {
          "type": "string"
        },
        "XL": {
          "type": "string"
        },
        "2XL": {
          "type": "string"
        },
        "3XL": {
          "type": "string"
        }
      },
      "default": {},
      "title": "Merchize Variant SKUs (by size)"
    },
    "artwork_front": {
      "type": "string",
      "default": "",
      "title": "Artwork - Front"
    },
    "artwork_back": {
      "type": "string",
      "default": "",
      "title": "Artwork - Back"
    },
    "artwork_sleeve": {
      "type": "string",
      "default": "",
      "title": "Artwork - Sleeve"
    },
    "artwork_hood": {
      "type": "string",
      "default": "",
      "title": "Artwork - Hood"
    },
    "variant_merchize_ids": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "color_name": {
            "type": "string",
            "default": ""
          },
          "combo_name": {
            "type": "string",
            "default": ""
          },
          "combo_number": {
            "type": "string",
            "default": ""
          },
          "merchize_product_id": {
            "type": "string",
            "default": ""
          },
          "title": {
            "type": "string",
            "default": ""
          },
          "manually_set": {
            "type": "boolean",
            "default": false
          },
          "variant_ids": {
            "type": "object",
            "properties": {
              "XS": {
                "type": "string"
              },
              "S": {
                "type": "string"
              },
              "M": {
                "type": "string"
              },
              "L": {
                "type": "string"
              },
              "XL": {
                "type": "string"
              },
              "2XL": {
                "type": "string"
              },
              "3XL": {
                "type": "string"
              }
            },
            "default": {}
          },
          "skus": {
            "type": "object",
            "properties": {
              "XS": {
                "type": "string"
              },
              "S": {
                "type": "string"
              },
              "M": {
                "type": "string"
              },
              "L": {
                "type": "string"
              },
              "XL": {
                "type": "string"
              },
              "2XL": {
                "type": "string"
              },
              "3XL": {
                "type": "string"
              }
            },
            "default": {}
          }
        }
      },
      "default": [],
      "title": "Per-Variant Merchize Product IDs"
    }
  },
  "required": [
    "name",
    "team",
    "fitting",
    "price",
    "front_image",
    "back_image"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}