{
  "name": "Jersey",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Jersey Name"
    },
    "team": {
      "type": "string",
      "title": "Team"
    },
    "category": {
      "type": "string",
      "enum": [
        "Jersey",
        "Long Sleeve",
        "Hoodie",
        "Bag",
        "Hat"
      ],
      "default": "Jersey",
      "title": "Product Category"
    },
    "fitting": {
      "type": "string",
      "enum": [
        "Slim",
        "Regular",
        "Loose"
      ],
      "default": "Regular"
    },
    "price": {
      "type": "number",
      "title": "Price (USD)"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "number": {
            "type": "string"
          }
        }
      },
      "default": [],
      "title": "Product Images"
    },
    "front_image": {
      "type": "string",
      "title": "Front Image URL"
    },
    "back_image": {
      "type": "string",
      "title": "Back Image URL"
    },
    "enable_customization": {
      "type": "boolean",
      "default": true,
      "title": "Enable Identity Lab"
    },
    "static_display": {
      "type": "boolean",
      "default": false,
      "title": "Static Display (No Flip)"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "title": "Featured on Landing"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "title": "Listing Sort Order"
    },
    "name_style": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string",
          "default": "#F5F5F7"
        },
        "outline": {
          "type": "boolean",
          "default": true
        },
        "outline_color": {
          "type": "string",
          "default": "#0A0A0A"
        },
        "outline_thickness": {
          "type": "number",
          "default": 1.4
        },
        "arch": {
          "type": "number",
          "default": 0
        },
        "rise": {
          "type": "number",
          "default": 0
        },
        "flag": {
          "type": "number",
          "default": 0
        },
        "horiz_pos": {
          "type": "number",
          "default": 50
        },
        "vert_pos": {
          "type": "number",
          "default": 50
        },
        "font_size": {
          "type": "number",
          "default": 42
        }
      },
      "default": {}
    },
    "number_style": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string",
          "default": "#F5F5F7"
        },
        "outline": {
          "type": "boolean",
          "default": true
        },
        "outline_color": {
          "type": "string",
          "default": "#0A0A0A"
        },
        "outline_thickness": {
          "type": "number",
          "default": 1.4
        },
        "arch": {
          "type": "number",
          "default": 0
        },
        "rise": {
          "type": "number",
          "default": 0
        },
        "flag": {
          "type": "number",
          "default": 0
        },
        "horiz_pos": {
          "type": "number",
          "default": 50
        },
        "vert_pos": {
          "type": "number",
          "default": 50
        },
        "font_size": {
          "type": "number",
          "default": 76
        }
      },
      "default": {}
    },
    "custom_font_url": {
      "type": "string",
      "default": "",
      "title": "Custom Font File URL"
    },
    "custom_font_name": {
      "type": "string",
      "default": "",
      "title": "Custom Font Name"
    },
    "is_private": {
      "type": "boolean",
      "default": false,
      "title": "Private (Club Exclusive)"
    },
    "private_access_code": {
      "type": "string",
      "default": "",
      "title": "Private Access Code"
    },
    "available_from": {
      "type": "string",
      "format": "date-time",
      "default": "",
      "title": "Available From"
    },
    "available_until": {
      "type": "string",
      "format": "date-time",
      "default": "",
      "title": "Available Until"
    }
  },
  "required": [
    "name",
    "team",
    "fitting",
    "price",
    "front_image",
    "back_image"
  ]
}