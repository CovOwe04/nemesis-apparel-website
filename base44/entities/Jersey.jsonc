{
  "name": "Jersey",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Jersey Name"
    },
    "team": {
      "type": "string",
      "title": "Team"
    },
    "category": {
      "type": "string",
      "enum": [
        "Jersey",
        "Long Sleeve",
        "Hoodie",
        "Bag",
        "Hat"
      ],
      "default": "Jersey",
      "title": "Product Category"
    },
    "fitting": {
      "type": "string",
      "enum": [
        "Slim",
        "Regular",
        "Loose"
      ],
      "default": "Regular"
    },
    "price": {
      "type": "number",
      "title": "Price (USD)"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "number": {
            "type": "string"
          }
        }
      },
      "default": [],
      "title": "Product Images"
    },
    "front_image": {
      "type": "string",
      "title": "Front Image URL"
    },
    "back_image": {
      "type": "string",
      "title": "Back Image URL"
    },
    "enable_customization": {
      "type": "boolean",
      "default": true,
      "title": "Enable Identity Lab"
    },
    "static_display": {
      "type": "boolean",
      "default": false,
      "title": "Static Display (No Flip)"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "title": "Featured on Landing"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "title": "Listing Sort Order"
    },
    "text_color": {
      "type": "string",
      "default": "#F5F5F7",
      "title": "Default Text Color"
    },
    "text_outline": {
      "type": "boolean",
      "default": true,
      "title": "Enable Text Outline"
    },
    "text_outline_color": {
      "type": "string",
      "default": "#0A0A0A",
      "title": "Text Outline Color"
    },
    "text_outline_thickness": {
      "type": "number",
      "default": 1.4,
      "title": "Text Outline Thickness"
    },
    "arch_amount": {
      "type": "number",
      "default": 0,
      "title": "Arch Amount"
    },
    "rise_angle": {
      "type": "number",
      "default": 0,
      "title": "Rise Angle"
    },
    "flag_amount": {
      "type": "number",
      "default": 0,
      "title": "Flag Amount"
    },
    "name_vertical_pos": {
      "type": "number",
      "default": 25,
      "title": "Name Vertical Position"
    },
    "number_vertical_pos": {
      "type": "number",
      "default": 50,
      "title": "Number Vertical Position"
    },
    "custom_font_url": {
      "type": "string",
      "default": "",
      "title": "Custom Font File URL"
    },
    "custom_font_name": {
      "type": "string",
      "default": "",
      "title": "Custom Font Name"
    },
    "is_private": {
      "type": "boolean",
      "default": false,
      "title": "Private (Club Exclusive)"
    },
    "private_access_code": {
      "type": "string",
      "default": "",
      "title": "Private Access Code"
    },
    "available_from": {
      "type": "string",
      "format": "date-time",
      "default": "",
      "title": "Available From"
    },
    "available_until": {
      "type": "string",
      "format": "date-time",
      "default": "",
      "title": "Available Until"
    }
  },
  "required": [
    "name",
    "team",
    "fitting",
    "price",
    "front_image",
    "back_image"
  ]
}