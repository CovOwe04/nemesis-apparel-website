{
  "name": "Order",
  "type": "object",
  "properties": {
    "items_json": {
      "type": "string",
      "title": "Order Items (JSON)"
    },
    "customer_name": {
      "type": "string",
      "title": "Customer Name"
    },
    "customer_email": {
      "type": "string",
      "title": "Customer Email"
    },
    "customer_phone": {
      "type": "string",
      "default": "",
      "title": "Customer Phone"
    },
    "ip_address": {
      "type": "string",
      "default": "",
      "title": "Client IP Address"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "pending_approval",
        "approved",
        "rejected",
        "fulfilled"
      ],
      "default": "pending",
      "title": "Order Status"
    },
    "total": {
      "type": "number",
      "title": "Total (USD)"
    },
    "item_count": {
      "type": "number",
      "default": 0,
      "title": "Item Count"
    },
    "has_custom_names": {
      "type": "boolean",
      "default": false,
      "title": "Has Custom Name Lab Items"
    },
    "admin_notes": {
      "type": "string",
      "default": "",
      "title": "Admin Notes"
    },
    "merchize_order_id": {
      "type": "string",
      "default": "",
      "title": "Merchize Fulfillment Order ID"
    },
    "stripe_payment_id": {
      "type": "string",
      "default": "",
      "title": "Stripe Payment Intent ID"
    },
    "shipping_address_json": {
      "type": "string",
      "default": "",
      "title": "Shipping Address (JSON)"
    }
  },
  "required": [
    "items_json",
    "customer_name",
    "customer_email",
    "status",
    "total"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}