{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "merchize_status_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sync-merchize-order-status"
          },
          "then": "end",
          "x-base44": {
            "title": "Sync Merchize fulfillment status",
            "description": "Marks approved orders as fulfilled once Merchize confirms shipment"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 */6 * * *",
      "one_time_date": null,
      "timezone": "America/Toronto",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Merchize Status Sync",
  "description": "Every 6 hours, checks approved Merchize orders and marks them fulfilled once shipment is confirmed"
}